{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>nca-apprentices/.github",
    ":pinAllExceptPeerDependencies",
    "docker:pinDigests"
  ],
  "packageRules": [
    {
      "description": "Everything arrives as one PR per schedule window, so mise.toml, go.mod, and the image move to a new Go together.",
      "matchPackageNames": ["*"],
      "groupName": "dependencies",
      "separateMajorMinor": false
    }
  ]
}

{
  "name": "ncaleague-backend",
  "version": "1.2.0",
  "scripts": {
    "dev": "bun run models && bun run --hot src/index.ts",
    "build": "bun run lint && bun build src/index.ts --target bun --outdir ./target",
    "serve": "bun run target/index.js",
    "lint": "bun run eslint src",
    "typecheck": "tsc",
    "db:up": "docker-compose -f db/docker-compose.yml up -d",
    "db:migrate": "bun run dbmate up",
    "db:rollback": "bun run dbmate down",
    "db:down": "docker-compose -f db/docker-compose.yml down",
    "models": "openapi-generator-cli generate -i ../api/openapi.yaml -g typescript-fetch -o ../api/types"
  },
  "dependencies": {
    "hono": "4.13.11",
    "kysely": "0.29.6",
    "pg": "8.23.0",
    "pino": "10.3.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@openapitools/openapi-generator-cli": "2.41.0",
    "@types/bun": "1.4.2",
    "@types/node": "25.9.8",
    "@types/pg": "8.23.1",
    "dbmate": "2.36.0",
    "eslint": "10.11.0",
    "eslint-plugin-no-relative-import-paths": "1.7.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0"
  },
  "overrides": {
    "@types/node": "25.9.8"
  }
}
